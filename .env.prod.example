# Production secrets for docker-compose.prod.yml -- copy to .env.prod (which
# is gitignored) and fill in. Run everything as:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml <cmd>
# Only POSTGRES_PASSWORD, BETTER_AUTH_SECRET, BETTER_AUTH_URL and (for the
# tunnel profile) CLOUDFLARE_TUNNEL_TOKEN are required; everything else has a
# documented fallback.

# --- Postgres (required) ------------------------------------------------------
# openssl rand -base64 24
POSTGRES_PASSWORD=
# Defaults if you leave them unset: postgres / taakify. Internal topology
# (service hostnames, ports) is set in the compose file, not here.
# POSTGRES_USER=postgres
# POSTGRES_DB=taakify
# Password migration 0003_rls.sql currently hardcodes for the RLS-scoped
# taakify_app role -- do not change until that migration is parameterized
# (security-pass TODO). Listed here so the wiring is ready when it is.
# APP_DB_PASSWORD=taakify_app_dev

# --- Auth (required) ----------------------------------------------------------
# openssl rand -base64 32  -- the API refuses to start on the dev fallback.
BETTER_AUTH_SECRET=
# The real HTTPS origin users type in the browser.
BETTER_AUTH_URL=https://app.example.com

# --- Google sign-in (optional -- button stays hidden when unset) --------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Object storage for book covers (optional) --------------------------------
# Unset = container-local disk (taakify_storage volume). That works but is
# wipeable via `docker compose down -v`, so R2/S3 is recommended for real use.
# Cloudflare R2 example endpoint:
#   https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=auto
# Public URL the browser loads covers from (e.g. the R2 bucket's public domain):
# STORAGE_PUBLIC_BASE_URL=

# --- Error tracking (optional until the Sentry step) --------------------------
# Server DSN; consumed by the backup sidecar's failure alert now, by the API
# itself once spec §11 step 4 lands.
# SENTRY_DSN=

# --- Cloudflare Tunnel (required for the `tunnel` profile) ---------------------
# Zero Trust dashboard -> Networks -> Tunnels -> Create tunnel -> copy token.
# Ingress rules live in the dashboard, not here -- see docs/deploy.md.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Backups -------------------------------------------------------------------
# BACKUP_RETENTION_DAYS=14
# Off-VM push: name the rclone remote "r2" (the compose file passes through
# exactly these RCLONE_CONFIG_R2_* vars). For a Cloudflare R2 bucket:
#   RCLONE_REMOTE=r2:taakify-backups
#   RCLONE_CONFIG_R2_TYPE=s3
#   RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   RCLONE_CONFIG_R2_ACCESS_KEY_ID=<r2 access key>
#   RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=<r2 secret>
#   RCLONE_CONFIG_R2_REGION=auto
# RCLONE_REMOTE=
# RCLONE_CONFIG_R2_TYPE=
# RCLONE_CONFIG_R2_ENDPOINT=
# RCLONE_CONFIG_R2_ACCESS_KEY_ID=
# RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_R2_REGION=auto
